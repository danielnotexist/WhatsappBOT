# =====================================================================
# .env.example — תבנית משתני סביבה (ללא ערכים אמיתיים!)
# מקומי: להעתיק ל-.env.local (לא נכנס ל-git) ולמלא.
# פרודקשן: Vercel → Project → Settings → Environment Variables (Production + Preview).
# הוולידציה: lib/env.ts (zod). חסר/שגוי → שגיאה ברורה בקריאה הראשונה ל-serverEnv().
# =====================================================================

# --------------------------- האפליקציה ---------------------------
# כתובת האתר המלאה. מקומי: http://localhost:3000 · פרודקשן: הדומיין שנקנה (PLAN §7)
APP_URL=http://localhost:3000
# אותו ערך לדפדפן (אופציונלי; משמש ל-metadataBase / קישורים בצד לקוח)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------- מצב פיתוח ---------------------------
# DATA_MODE=memory — שכבת נתונים בזיכרון + קודי OTP לקונסול (בלי Supabase/Resend). רק לפיתוח ולבדיקות; אסור ב-production.
# DATA_MODE=memory

# --------------------------- Supabase (Pro, Frankfurt) ---------------------------
# supabase.com → הפרויקט → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# שם → Project API keys → anon / public
SUPABASE_ANON_KEY=
# שם → service_role (secret). רק בשרת! לעולם לא בקידומת NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------- הצפנת טוקני OAuth (PLAN §2.3) ---------------------------
# מפתח AES-256-GCM, base64 של 32 בייט בדיוק. יצירה:  openssl rand -base64 32
# נשמר רק ב-Vercel env (לא ב-DB). אובדן המפתח = כל הטוקנים השמורים לא ניתנים לפענוח — לגבות במנהל סיסמאות.
TOKEN_ENC_KEY=

# --------------------------- WhatsApp Cloud API (Meta) ---------------------------
# developers.facebook.com → האפליקציה → WhatsApp → API Setup → "Phone number ID" (של ה-SIM הישראלי הייעודי)
WA_PHONE_NUMBER_ID=
# המספר הציבורי של הבוט (ה-SIM הישראלי) בפורמט בינלאומי בלי + — משמש לקישור wa.me בהרשמה
WA_PUBLIC_NUMBER=972501234567
# business.facebook.com → Business settings → Users → System users → המשתמש → Generate token
# (הרשאות: whatsapp_business_messaging + whatsapp_business_management; תוקף: Never)
WA_ACCESS_TOKEN=
# מחרוזת אקראית שאתם ממציאים (openssl rand -hex 16). את אותו ערך מזינים ב:
# developers.facebook.com → WhatsApp → Configuration → Webhook → "Verify token"
WA_VERIFY_TOKEN=
# developers.facebook.com → האפליקציה → App settings → Basic → "App secret" (לאימות X-Hub-Signature-256 בכל webhook)
META_APP_SECRET=

# --------------------------- Microsoft 365 (Entra ID, multi-tenant) ---------------------------
# portal.azure.com → Microsoft Entra ID → App registrations → האפליקציה → Overview → "Application (client) ID"
MS_CLIENT_ID=
# שם → Certificates & secrets → New client secret → העמודה "Value" (מוצג פעם אחת בלבד!)
MS_CLIENT_SECRET=
# "common" = כל ארגון + חשבונות אישיים (ברירת מחדל). "organizations" = ארגונים בלבד.
MS_TENANT=common

# --------------------------- Google ---------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs → Web application
# (OAuth consent screen: External; scopes: calendar, drive.file, gmail.send — PLAN §2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------- AI, תמלול, תמונות ---------------------------
# platform.claude.com → API keys
ANTHROPIC_API_KEY=
# console.soniox.com → API keys (תמלול הודעות קוליות בעברית)
SONIOX_API_KEY=
# ספק התמלול: soniox (ברירת מחדל) | openai | mock. ב-DATA_MODE=memory ברירת המחדל היא mock (בלי קריאות בתשלום).
# STT_PROVIDER=soniox
# אופציונלי: platform.openai.com → API keys. עם soniox — גיבוי אוטומטי ל-gpt-4o-transcribe כש-Soniox נכשל; חובה אם STT_PROVIDER=openai.
# OPENAI_API_KEY=
# openrouter.ai → Keys (יצירת תמונות/איורים בלבד)
OPENROUTER_API_KEY=

# --------------------------- HYP Pay (יעד שריג) ---------------------------
# פורטל HYP (pay.hyp.co.il) → הגדרות → "דף תשלום ו-API": מספר מסוף (Masof), מפתח API (KEY), סיסמת API (PassP).
# במסוף חייבים להפעיל: טוקנים (אחרת CCode=901), ו-"אימות על ידי חתימה בעמודי התשלום" (ל-VERIFY).
# לפיתוח: מסוף הבדיקה שמקבלים מנציג HYP (00100…).
HYP_MASOF=
HYP_KEY=
HYP_PASSP=

# --------------------------- Upstash QStash ---------------------------
# console.upstash.com → QStash → בלשונית הראשית: "QSTASH_TOKEN", "Current Signing Key", "Next Signing Key"
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --------------------------- Resend (קוד OTP במייל) ---------------------------
# resend.com → API Keys → Create (אחרי אימות הדומיין ב-Domains, אחרת אפשר לשלוח רק לכתובת שלכם)
RESEND_API_KEY=
