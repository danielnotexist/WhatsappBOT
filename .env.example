# =====================================================================
# .env.example — תבנית משתני סביבה (ללא ערכים אמיתיים!)
# מקומי: להעתיק ל-.env.local (לא נכנס ל-git) ולמלא.
# פרודקשן: Vercel → Project → Settings → Environment Variables (Production + Preview).
# הוולידציה: lib/env.ts (zod). חסר/שגוי → שגיאה ברורה בקריאה הראשונה ל-serverEnv().
# =====================================================================

# --------------------------- האפליקציה ---------------------------
# כתובת האתר המלאה. מקומי: http://localhost:3000 · פרודקשן: הדומיין שנקנה (PLAN §7)
APP_URL=http://localhost:3000
# אותו ערך לדפדפן (אופציונלי; משמש ל-metadataBase / קישורים בצד לקוח)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------- מצב פיתוח ---------------------------
# DATA_MODE=memory — שכבת נתונים בזיכרון + קודי OTP לקונסול (בלי Supabase/Resend). רק לפיתוח ולבדיקות; אסור ב-production.
# DATA_MODE=memory
# DEMO_MODE=1 — גרסת הדגמה (גם ב-production): קוד 123456, כל האינטגרציות מדומות, noindex, פס "גרסת הדגמה".
# נתונים ב-Supabase אם הוגדר, אחרת בזיכרון. דורש TOKEN_ENC_KEY, ומסרב לעלות ליד WA_ACCESS_TOKEN / HYP_KEY / HYP_PASSP /
# MS_CLIENT_SECRET / GOOGLE_CLIENT_SECRET / RESEND_API_KEY / QSTASH_TOKEN. המדריך: docs/deploy.md
# בפריסת ה-production של Vercel (VERCEL_ENV=production) ההדגמה מסרבת לעלות: הקוד הקבוע נכנס לכל חשבון קיים.
# DEMO_ON_PRODUCTION=1 מתיר אותה שם - רק לפרויקט הדגמה נפרד, בלי נתונים אמיתיים.
# DEMO_MODE=1
# DEMO_ON_PRODUCTION=1
# WEB_CHAT=1 — הצ'אט באתר (/demo/chat) גם מחוץ להדגמה: רק למשתמש מחובר, ורק על מספר הוואטסאפ האמיתי שכבר מקושר
# לחשבון שלו (בלי מספר וירטואלי +999). בלי הדגל, מחוץ להדגמה הדף והנתיב עונים 404.
# WEB_CHAT=1
# LIVE_AI=1 — רק יחד עם DEMO_MODE=1: המודל האמיתי (Anthropic, ANTHROPIC_API_KEY) והתמלול האמיתי (OpenRouter,
# OPENROUTER_API_KEY, deepgram/nova-3) עונים, וכל השאר נשאר מדומה (וואטסאפ, מייל, HYP, Microsoft, Google, התור).
# הבדיקה נעשית בצ'אט באתר: /demo/chat (רק למשתמש מחובר). בלי DEMO_MODE אין לדגל משמעות. המדריך: docs/deploy.md §9
# בפריסה (Vercel או next start) LIVE_AI דורש Supabase (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY, מיגרציות 0009 ו-0010):
# בלי טבלת ai_spend משותפת לכל השרתים התקרה לא נאכפת, ולכן ההודעה הראשונה נכשלת בשגיאה בעברית במקום לקרוא למודל.
# LIVE_AI=1
# תקרת ההוצאה היומית בדולרים על קריאות AI ותמלול (יום = לוח השנה של ישראל). ב-LIVE_AI ברירת המחדל 3; 0 = לעצור הכול.
# מחוץ להדגמה, עם המודל האמיתי, בלי ערך כאן התקרה היא 10 (אף פעם לא בלי תקרה). כשמגיעים אליה הבוט עונה במשפט אחד ולא קורא ל-API.
# הספירה בטבלה ai_spend (מיגרציות 0009 ו-0010) — צריך להריץ את שתיהן ב-Supabase לפני שמדליקים.
# כל קריאה שומרת מראש הערכה עליונה של העלות שלה ונסגרת לפי העלות בפועל, כך שקריאות במקביל לא עוברות את התקרה יחד.
# AI_DAILY_BUDGET_USD=3
# כמה הודעות של משתמש אחד ביום מגיעות למודל או לתמלול במצב LIVE_AI (ברירת מחדל 60).
# DEMO_USER_DAILY_MESSAGES=60
# לצ'אט התמיכה האנונימי באתר יש תקרה יומית נפרדת (טבלה ai_spend_pools, מיגרציה 0024), כדי שמבקרים לא ינצלו את התקרה של הבוט.
# ברירת מחדל 0.5, ולעולם לא יותר מ-AI_DAILY_BUDGET_USD. כשהיא נגמרת הצ'אט עונה ממאגר הידע.
# SUPPORT_AI_DAILY_BUDGET_USD=0.5

# --------------------------- Supabase (Pro, Frankfurt) ---------------------------
# supabase.com → הפרויקט → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# שם → Project API keys → anon / public
SUPABASE_ANON_KEY=
# שם → service_role (secret). רק בשרת! לעולם לא בקידומת NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------- הצפנת טוקני OAuth (PLAN §2.3) ---------------------------
# מפתח AES-256-GCM, base64 של 32 בייט בדיוק. יצירה:  openssl rand -base64 32
# נשמר רק ב-Vercel env (לא ב-DB). אובדן המפתח = כל הטוקנים השמורים לא ניתנים לפענוח — לגבות במנהל סיסמאות.
TOKEN_ENC_KEY=
# SESSION_EPOCH — מספר שלם, נכנס רק למפתח החתימה של ה-session. העלאה שלו (למשל ל-2) מנתקת את כולם בבת אחת: כל עוגיות
# הכניסה וכל הקישורים החתומים (כניסה מוואטסאפ, חיבור, תשלום, כרטיס, קבלה, הצעות) מפסיקים לעבוד. הטוקנים המוצפנים
# ב-TOKEN_ENC_KEY לא מושפעים. ריק / 1 = המפתח של היום. לכיבוי ההדגמה: SESSION_EPOCH=2.
SESSION_EPOCH=

# --------------------------- WhatsApp Cloud API (Meta) ---------------------------
# developers.facebook.com → האפליקציה → WhatsApp → API Setup → "Phone number ID" (של ה-SIM הישראלי הייעודי)
WA_PHONE_NUMBER_ID=
# המספר הציבורי של הבוט (ה-SIM הישראלי) בפורמט בינלאומי בלי + — משמש לקישור wa.me בהרשמה
WA_PUBLIC_NUMBER=972501234567
# business.facebook.com → Business settings → Users → System users → המשתמש → Generate token
# (הרשאות: whatsapp_business_messaging + whatsapp_business_management; תוקף: Never)
WA_ACCESS_TOKEN=
# מחרוזת אקראית שאתם ממציאים (openssl rand -hex 16). את אותו ערך מזינים ב:
# developers.facebook.com → WhatsApp → Configuration → Webhook → "Verify token"
WA_VERIFY_TOKEN=
# developers.facebook.com → האפליקציה → App settings → Basic → "App secret" (לאימות X-Hub-Signature-256 בכל webhook)
META_APP_SECRET=

# --------------------------- Microsoft 365 (Entra ID, multi-tenant) ---------------------------
# portal.azure.com → Microsoft Entra ID → App registrations → האפליקציה → Overview → "Application (client) ID"
MS_CLIENT_ID=
# שם → Certificates & secrets → New client secret → העמודה "Value" (מוצג פעם אחת בלבד!)
MS_CLIENT_SECRET=
# "common" = כל ארגון + חשבונות אישיים (ברירת מחדל). "organizations" = ארגונים בלבד.
MS_TENANT=common

# --------------------------- Google ---------------------------
# המדריך המלא: docs/google-setup.md
# console.cloud.google.com → בוחרים את הפרויקט → APIs & Services → Credentials → Create credentials →
# OAuth client ID → Application type: "Web application".
#   Authorized redirect URIs: <APP_URL>/api/auth/google/callback  (למשל http://localhost:3000/api/auth/google/callback)
# אחרי היצירה: "Client ID" נכנס כאן, ו-"Client secret" למשתנה הבא (אפשר להוריד JSON מאותו מסך).
# (OAuth consent screen → Audience: External; Data access: openid, email, profile, calendar.events, drive.file, gmail.send)
GOOGLE_CLIENT_ID=
# אותו מסך → "Client secret" (Credentials → OAuth 2.0 Client IDs → הלקוח → Client secrets). סוד — רק בשרת.
GOOGLE_CLIENT_SECRET=
# קריאת תיבת Gmail (gmail.readonly) — scope "מוגבל". בלי CASA, Google מרשה לאפליקציה לא מאומתת עד 100 משתמשים
# (לכל חיי הפרויקט; מי שביטל עדיין נספר). ריק = פעיל כש-GOOGLE_CLIENT_ID מוגדר.
# false = מתג כיבוי: לא מבקשים gmail.readonly, וגם מי שכבר אישר מפסיק מיד לקרוא (כלי gmail_*, סיכום הבוקר);
# ההרשאה נשארת אצל Google: בחזרה ל-true הקריאה חוזרת בלי אישור חדש (למי שהתחבר מחדש בזמן הכיבוי — אישור אחד נוסף,
# בלי מקום חדש בתקרה). docs/google-setup.md §6.
GOOGLE_GMAIL_READ_ENABLED=
# קריאת כל קובצי ה-Drive (drive.readonly) — גם הוא scope "מוגבל": חיפוש בכל ה-Drive וקריאת Docs / Sheets / Slides.
# אותם תנאים כמו קריאת Gmail (אותה תקרה). ריק = פעיל כש-GOOGLE_CLIENT_ID מוגדר. false = מתג כיבוי. docs/google-setup.md §6.
GOOGLE_DRIVE_READ_ENABLED=
# כמה חשבונות Google שונים מותר שיאשרו scope לא מאומת לפני שמפסיקים לבקש gmail.readonly / drive.readonly ממשתמשים חדשים (ברירת מחדל 95).
GOOGLE_GMAIL_READ_CAP=95
# true רק אחרי ש-Google אישרה ב-Verification Center את calendar.events, gmail.send ו-tasks. עד אז כל חיבור Google נספר בתקרה.
GOOGLE_SENSITIVE_SCOPES_VERIFIED=false

# --------------------------- תפעול ---------------------------
# אופציונלי: לאן לשלוח התראות תפעול (תקרת המשתמשים של Google ב-80 וב-95) דרך Resend. ריק = לוג + דגל בטבלת ops_flags בלבד.
OPERATOR_EMAIL=
# תיבת התמיכה: לאן נשלחות פניות מצ'אט התמיכה באתר ("פתיחת פנייה", דרך Resend, עם Reply-To של הפונה).
# חובה כשהמייל אמיתי; בלי - הפנייה נשמרת בטבלה support_tickets (מיגרציה 0011) ושגיאה בעברית נרשמת בלוג.
# בהדגמה ובפיתוח ברירת המחדל support@<הדומיין>, והמייל רק נרשם לקונסול.
SUPPORT_EMAIL=
# פאנל הניהול (/admin): מי נכנס, כתובות מופרדות בפסיק. ריק = danielnotexist@gmail.com.
# הכתובת לבדה לא מכניסה: בכל כניסה נשלח אליה קוד חד-פעמי אמיתי ב-Resend (גם במצב הדגמה, אף פעם לא 123456).
# במצב הדגמה זה דורש LIVE_SUPPORT_MAIL=1 + RESEND_API_KEY (אותו מתג של מייל הפניות); בלי מייל אמיתי הכניסה לפאנל נכשלת עם הודעה.
ADMIN_EMAILS=
# התראות לבעלים (lib/admin/alerts.ts, הטאב "התראות" ב-/admin): נשלחות במייל אל ADMIN_EMAILS דרך Resend — אותו מסלול של
# קוד הכניסה לפאנל (בהדגמה: LIVE_SUPPORT_MAIL=1). המתגים, שעות השקט והשבת נשמרים בפאנל (ops_flags), לא כאן.
# וואטסאפ לבעלים: כבוי. להפעיל (OWNER_ALERT_WA=1) רק אחרי שהתבנית owner_alert אושרה ב-Meta (docs/copy/wa-templates.md),
# ואז חובה ADMIN_PHONE: הטלפון של הבעלים בפורמט בינלאומי, ספרות בלבד, למשל 972501234567.
OWNER_ALERT_WA=
ADMIN_PHONE=
# המתזמן בייצור: Supabase (מיגרציה 0019, pg_cron + pg_net) קורא כל דקה ל-GET /api/jobs/tick עם
# Authorization: Bearer <CRON_SECRET>; אותו ערך נשמר ב-Vault בשם cron_secret. בלעדיו תזכורות, סיכומי בוקר, התראות יזומות
# ומייל הבוקר לבעלים לא רצים. 32 תווים לפחות (קצר יותר = כאילו לא הוגדר): openssl rand -base64 24
# גם הפרטים של GET /api/health (מצב, commit, משתנים חסרים) רק עם אותו Bearer; בלעדיו התשובה היא { ok: true } בלבד.
CRON_SECRET=

# --------------------------- AI, תמלול, תמונות ---------------------------
# platform.claude.com → API keys. ב-Vercel: משתנה מסוג Sensitive בלבד (לא בריפו, לא בצ'אט, לא בלוגים).
ANTHROPIC_API_KEY=
# openrouter.ai → Keys. מפתח אחד לתמלול הודעות קוליות (ברירת המחדל) וליצירת תמונות/איורים.
# החיוב מהקרדיט שנטען ב-OpenRouter, לפי שניות שמע (deepgram/nova-3 ≈ $0.0043 לדקה); אין מנוי חודשי.
OPENROUTER_API_KEY=
# ספק התמלול: openrouter (ברירת מחדל) | soniox | openai | mock.
# ב-DATA_MODE=memory ברירת המחדל היא mock (בלי קריאות בתשלום), אבל STT_PROVIDER שמוגדר במפורש גובר — גם ב-memory הוא מתמלל באמת ומחויב.
# במצב הדגמה (DEMO_MODE=1) — mock, חוץ מ-LIVE_AI=1: אז OpenRouter (או mock אם STT_PROVIDER=mock).
# דרך OpenRouter השמע נשלח רק לספקים שלא אוספים אותו (data_collection=deny). ספקי המשנה לתמלול: docs/legal/privacy-policy-he.md §6.
# STT_PROVIDER=openrouter
# מודל התמלול ב-OpenRouter. ברירת מחדל: deepgram/nova-3 — הכי מדויק בעברית מבין המודלים ב-OpenRouter שנמדדו ב-ivrit.ai (WER 12% על הקלטות וואטסאפ).
# STT_MODEL=deepgram/nova-3
# מודל גיבוי, כשהראשי נכשל או מחזיר תמלול ריק. ברירת מחדל: openai/gpt-transcribe. none = בלי גיבוי.
# STT_FALLBACK_MODEL=openai/gpt-transcribe
# אופציונלי, רק אם STT_PROVIDER=soniox: console.soniox.com → API keys.
# SONIOX_API_KEY=
# אופציונלי: platform.openai.com → API keys. חובה אם STT_PROVIDER=openai; עם soniox — גיבוי ל-gpt-4o-transcribe.
# OPENAI_API_KEY=

# --------------------------- HYP Pay (יעד שריג) ---------------------------
# פורטל HYP (pay.hyp.co.il) → הגדרות → "דף תשלום ו-API": מספר מסוף (Masof), מפתח API (KEY), סיסמת API (PassP).
# במסוף חייבים להפעיל: טוקנים (אחרת CCode=901), ו-"אימות על ידי חתימה בעמודי התשלום" (ל-VERIFY).
# לפיתוח: מסוף הבדיקה שמקבלים מנציג HYP (00100…). מה לבקש מ-HYP, כרטיסי בדיקה והגדרות הפורטל: docs/hyp-setup.md
HYP_MASOF=
HYP_KEY=
HYP_PASSP=
# מחוץ להדגמה, בלי מסוף אמיתי (שלושת המשתנים, לא מסוף בדיקה 00100) דף התשלום אומר "התשלום ייפתח בקרוב" ולא פותח כלום.
# בהדגמה (DEMO_MODE=1): LIVE_HYP=1 מפעיל HYP אמיתי - רק כש-HYP_MASOF הוא מסוף בדיקה (מתחיל ב-00100). ליד מסוף אמיתי ההדגמה לא עולה.
LIVE_HYP=

# --------------------------- Upstash QStash ---------------------------
# console.upstash.com → QStash → בלשונית הראשית: "QSTASH_TOKEN", "Current Signing Key", "Next Signing Key"
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --------------------------- Resend (קוד OTP במייל) ---------------------------
# resend.com → API Keys → Create (אחרי אימות הדומיין ב-Domains, אחרת אפשר לשלוח רק לכתובת שלכם)
RESEND_API_KEY=
